# Example .env for TG Shop
# Copy this file to .env and fill values. Do NOT commit secrets.

# Telegram
BOT_TOKEN=
ADMIN_IDS=123456789,987654321

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/tg_shop

# Fragment (API key / cookies)
FRAGMENT_API_KEY=
FRAGMENT_COOKIES=

# TON wallet / seed (use secure storage for production)
TON_SEED=
TON_WALLET=

# Payment gateways
CRYPTOBOT_TOKEN=
LOLZ_API_KEY=
CRYSTALPAY_KEY=

# Redis / Caching
REDIS_URL=redis://localhost:6379/0

# Logging & monitoring
LOG_LEVEL=INFO
SENTRY_DSN=

# Webhook (if using)
WEBHOOK_URL=

# Remnawave panel (VPN)
# Panel base URL (the client appends /api automatically)
REMNAWAVE_BASE_URL=https://panel.example.com
# Bearer API token: Panel -> API Tokens
REMNAWAVE_TOKEN=
# Internal squad UUIDs assigned on user creation (comma-separated).
# Standard tariff squads:
REMNAWAVE_SQUADS_STANDARD=
# Premium+ tariff squads (defaults to STANDARD if empty -> Premium+ disabled):
REMNAWAVE_SQUADS_PREMIUM=
# Set to false only if the panel uses a self-signed certificate
REMNAWAVE_VERIFY_SSL=true
# eGames reverse-proxy access cookie (panel is hidden behind it in Caddyfile).
# Take the Name=Value from the panel's Caddyfile, e.g. SFuMcqjZ=XQQxucKM
REMNAWAVE_COOKIE=

# Optional: extra config
EXTRA_OPTIONS=